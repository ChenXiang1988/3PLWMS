          { "label": "拆分原因", "key": "decisionReason", "type": "textarea", "placeholder": "多履约单时填写，如库存不足、多仓、多包裹" },
          { "label": "规则版本", "key": "ruleVersion", "readonly": true }
        ] }
      ],
      "actions": [
        { "label": "下发 3PL", "primary": true, "attrs": { "data-form-action": "dispatch" } },
        { "label": "自发货", "ghost": true, "attrs": { "data-form-action": "selfship" } },
