{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "货主档案创建流程",
    "output": "货主档案创建流程.html",
    "quality_profile": "showcase",
    "viewBox": [1900, 1360]
  },
  "lanes": [
    { "id": "intake", "label": "发起与受理" },
    { "id": "entry", "label": "货灵运营中台管理端 · 建档录入" },
    { "id": "gate", "label": "校验与审核" },
    { "id": "master", "label": "主档落库与启用" },
    { "id": "exception", "label": "异常与处置", "variant": "exception" },
    { "id": "reverse", "label": "逆向与留痕", "variant": "exception" },
    { "id": "usage", "label": "货灵WMS / 货主端 · 使用" }
  ],
  "phases": [
    { "id": "p0", "label": "签约与录入", "fromCol": 0, "toCol": 0 },
    { "id": "p1", "label": "字段补全", "fromCol": 1, "toCol": 1 },
    { "id": "p2", "label": "校验", "fromCol": 2, "toCol": 2 },
    { "id": "p3", "label": "审核", "fromCol": 3, "toCol": 3 },
    { "id": "p4", "label": "落档与启用", "fromCol": 4, "toCol": 4 },
    { "id": "p5", "label": "下发与使用", "fromCol": 5, "toCol": 5 }
  ],
  "mainPath": ["start", "draft", "attrs", "validate", "submit", "review", "archive", "activate", "sync", "account", "u_wh", "end"],
  "nodes": [
    { "id": "start", "lane": "intake", "col": 0, "type": "external", "label": "服务商与货主签约", "sublabel": "发起货主建档申请", "tag": "起点" },
    { "id": "draft", "lane": "entry", "col": 0, "type": "frontend", "label": "货主档案 · 新增", "sublabel": "基础标识、联系地址" },
    { "id": "attrs", "lane": "entry", "col": 1, "type": "frontend", "label": "填业务与仓储属性", "sublabel": "资质、合同计费、服务仓库" },
    { "id": "validate", "lane": "gate", "col": 2, "type": "security", "label": "必填、编码与关联校验", "sublabel": "ownerCode、合同、serviceWarehouses" },
    { "id": "submit", "lane": "gate", "col": 3, "type": "backend", "label": "提交审核", "sublabel": "置待审核" },
    { "id": "review", "lane": "gate", "col": 4, "type": "security", "label": "货主主档审核", "sublabel": "已通过 / 已驳回" },
    { "id": "archive", "lane": "master", "col": 4, "type": "database", "label": "落货主主档并赋码", "sublabel": "ownerCode、createTime、createBy" },
    { "id": "activate", "lane": "master", "col": 5, "type": "backend", "label": "置货主状态启用", "sublabel": "ownerStatus = active" },
    { "id": "sync", "lane": "master", "col": 5, "type": "messagebus", "label": "下发各仓并互指仓库", "sublabel": "同步 serviceOwners / 仓库主档互指" },
    { "id": "account", "lane": "master", "col": 5, "type": "cloud", "label": "创建货主账号", "sublabel": "限定本货主与已授权仓库" },
    { "id": "e_dup", "lane": "exception", "col": 0, "type": "security", "label": "重复建档或并发占用", "sublabel": "拦截并留痕，转人工合并", "tag": "异常" },
    { "id": "e_field", "lane": "exception", "col": 1, "type": "security", "label": "校验失败", "sublabel": "必填缺失、格式或数量不符", "tag": "异常" },
    { "id": "e_code", "lane": "exception", "col": 2, "type": "security", "label": "编码与关联异常", "sublabel": "重复、合同过期、仓库不存在或错挂", "tag": "异常" },
    { "id": "e_perm", "lane": "exception", "col": 3, "type": "security", "label": "权限不足", "sublabel": "转有权限审核人并留痕", "tag": "异常" },
    { "id": "e_reject", "lane": "exception", "col": 4, "type": "security", "label": "已驳回", "sublabel": "留审核意见，退回修改", "tag": "异常" },
    { "id": "e_retry", "lane": "exception", "col": 5, "type": "messagebus", "label": "下发失败或超时", "sublabel": "重试下发", "tag": "异常" },
    { "id": "e_hold", "lane": "exception", "col": 5, "type": "security", "label": "重试仍失败", "sublabel": "挂起并告警，不开放开单", "tag": "异常终态" },
    { "id": "r_irreversible", "lane": "reverse", "col": 2, "type": "external", "label": "已产生单据或库存", "sublabel": "不可逆：冲正与退仓，台账不可删", "tag": "不可逆" },
    { "id": "r_withdraw", "lane": "reverse", "col": 3, "type": "security", "label": "撤回建档申请", "sublabel": "申请单留痕不可删", "tag": "逆向终态" },
    { "id": "r_void", "lane": "reverse", "col": 4, "type": "security", "label": "未下发前可作废", "sublabel": "ownerCode 不复用，主档留痕不可删", "tag": "逆向终态" },
    { "id": "r_reverse", "lane": "reverse", "col": 5, "type": "security", "label": "启用后发现字段错误", "sublabel": "反审核回待审核，原版本留痕", "tag": "可逆向" },
    { "id": "r_stop", "lane": "reverse", "col": 5, "type": "security", "label": "停用货主", "sublabel": "已下发部分同步撤回，台账留痕", "tag": "可再启用" },
    { "id": "u_wh", "lane": "usage", "col": 5, "type": "frontend", "label": "货灵WMS按货主作业", "sublabel": "收货、上架、拣货、盘点，库存隔离" },
    { "id": "u_owner", "lane": "usage", "col": 5, "type": "frontend", "label": "货主端按登录身份使用", "sublabel": "查库存与单据、提交委托、子账号" },
    { "id": "end", "lane": "usage", "col": 5, "type": "external", "label": "货主可开单", "sublabel": "进入日常业务", "tag": "正常终态" }
  ],
  "edges": [
    { "id": "sign_draft", "from": "start", "to": "draft", "label": "受理", "variant": "emphasis", "role": "main" },
    { "id": "draft_attrs", "from": "draft", "to": "attrs", "label": "录入", "variant": "default", "role": "main" },
    { "id": "attrs_validate", "from": "attrs", "to": "validate", "label": "校验", "variant": "default", "role": "main" },
    { "id": "validate_submit", "from": "validate", "to": "submit", "label": "通过", "variant": "emphasis", "role": "main" },
    { "id": "submit_review", "from": "submit", "to": "review", "label": "待审核", "variant": "default", "role": "main" },
    { "id": "review_archive", "from": "review", "to": "archive", "label": "已通过", "variant": "emphasis", "role": "main" },
    { "id": "archive_activate", "from": "archive", "to": "activate", "label": "写主档", "variant": "default", "role": "main" },
    { "id": "activate_sync", "from": "activate", "to": "sync", "label": "同步互指", "variant": "default", "role": "main" },
    { "id": "sync_account", "from": "sync", "to": "account", "label": "下发各仓", "variant": "default", "role": "main" },
    { "id": "account_wh", "from": "account", "to": "u_wh", "label": "下发完成", "variant": "default", "role": "main" },
    { "id": "account_owner", "from": "account", "to": "u_owner", "label": "账号开通", "variant": "default", "role": "main" },
    { "id": "wh_end", "from": "u_wh", "to": "end", "label": "可收货", "variant": "emphasis", "role": "main" },
    { "id": "owner_end", "from": "u_owner", "to": "end", "label": "可委托", "variant": "emphasis", "role": "main" },
    { "id": "draft_dup", "from": "draft", "to": "e_dup", "label": "重复或并发占用", "variant": "security", "role": "error" },
    { "id": "attrs_field", "from": "attrs", "to": "e_field", "label": "必填或格式不符", "variant": "security", "role": "error" },
    { "id": "validate_code", "from": "validate", "to": "e_code", "label": "编码或关联异常", "variant": "security", "role": "error" },
    { "id": "submit_perm", "from": "submit", "to": "e_perm", "label": "权限不足", "variant": "security", "role": "error" },
    { "id": "review_reject", "from": "review", "to": "e_reject", "label": "已驳回", "variant": "security", "role": "error" },
    { "id": "sync_retry", "from": "sync", "to": "e_retry", "label": "下发失败或超时", "variant": "security", "role": "error" },
    { "id": "retry_hold", "from": "e_retry", "to": "e_hold", "label": "重试仍失败", "variant": "security", "role": "error" },
    { "id": "attrs_withdraw", "from": "attrs", "to": "r_withdraw", "label": "录入中放弃", "variant": "dashed", "role": "branch" },
    { "id": "submit_withdraw", "from": "submit", "to": "r_withdraw", "label": "待审核撤回", "variant": "dashed", "role": "branch" },
    { "id": "archive_void", "from": "archive", "to": "r_void", "label": "要求作废", "variant": "dashed", "role": "branch" },
    { "id": "activate_reverse", "from": "activate", "to": "r_reverse", "label": "发现字段错误", "variant": "security", "role": "branch" },
    { "id": "sync_stop", "from": "sync", "to": "r_stop", "label": "需停用货主", "variant": "dashed", "role": "branch" },
    { "id": "account_irreversible", "from": "account", "to": "r_irreversible", "label": "已产生单据", "variant": "security", "role": "branch" },
    { "id": "dup_validate", "from": "e_dup", "to": "validate", "label": "人工合并后重校验", "variant": "dashed", "role": "return" },
    { "id": "field_draft", "from": "e_field", "to": "draft", "label": "补录后重校验", "variant": "dashed", "role": "return" },
    { "id": "code_attrs", "from": "e_code", "to": "attrs", "label": "退回修改并留痕", "variant": "dashed", "role": "return" },
    { "id": "perm_review", "from": "e_perm", "to": "review", "label": "转有权限审核人", "variant": "dashed", "role": "return" },
    { "id": "reject_draft", "from": "e_reject", "to": "draft", "label": "退回修改", "variant": "dashed", "role": "return" },
    { "id": "retry_sync", "from": "e_retry", "to": "sync", "label": "重试下发", "variant": "dashed", "role": "return" },
    { "id": "reverse_review", "from": "r_reverse", "to": "review", "label": "反审核回待审核", "variant": "dashed", "role": "return" },
    { "id": "stop_review", "from": "r_stop", "to": "review", "label": "重新启用须再审核", "variant": "dashed", "role": "return" }
  ]
}
